{
  "name": "@gymflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx --env-file-if-exists=.env prisma/seed.ts",
    "reminders:run": "tsx --env-file-if-exists=.env src/jobs/run-once.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gymflow/shared": "*",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "esbuild": "^0.25.10",
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
