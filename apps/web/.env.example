# Opcional. Vazio = a API está no mesmo domínio (/api), como na Netlify.
# Defina apenas se a API estiver alojada noutro domínio. Nunca coloque segredos aqui.
VITE_API_URL=

# Opcional. ID do kit Adobe Fonts com a Proxima Nova (licença necessária).
# Sem kit, usa-se a Proxima Nova instalada localmente ou a Montserrat como substituto.
VITE_ADOBE_FONTS_KIT=
