# =====================================================================
# GymFlow — variáveis de ambiente
# Copie para apps/api/.env (backend) e apps/web/.env (frontend).
# NUNCA faça commit de ficheiros .env com valores reais.
# =====================================================================

# ----------------------------- API ----------------------------------
NODE_ENV=development
PORT=4000
# PostgreSQL. Opcional: sem DATABASE_URL a API arranca em modo demonstração, com um Postgres
# em memória já preenchido (os dados perdem-se ao reiniciar). Para dados persistentes, defina-a.
# Em desenvolvimento com `npm run dev`, aponte para um Postgres local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymflow
# Na Netlify estes dois assumem o URL do site automaticamente.
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Código exigido pelo assistente de configuração inicial (/setup). Obrigatório na Netlify.
SETUP_TOKEN=
# Duração da sessão em horas
SESSION_TTL_HOURS=72
# Segredo para o endpoint de cron externo (POST /api/cron/reminders)
CRON_SECRET=change-me-to-a-long-random-string
# Executar o motor de lembretes dentro do processo (true/false)
REMINDERS_CRON_ENABLED=true

# ---- WhatsApp ----
# WHATSAPP_PROVIDER: webhook | meta | console
#   webhook: automação (ex.: n8n) com Basic Auth e templates gym_reminder / gym_warning
WHATSAPP_PROVIDER=console
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_USERNAME=
WHATSAPP_WEBHOOK_PASSWORD=
#   meta: WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Destinatários autorizados (telefones/emails separados por vírgula). Se definido, só estes
# recebem mensagens reais — use em testes e demonstrações. Deixe vazio em produção.
NOTIFICATIONS_ALLOWLIST=

# ---- Email ----
# EMAIL_PROVIDER: smtp | console
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GymFlow <no-reply@example.com>"

# ---- SMS (provedor HTTP genérico) ----
# SMS_PROVIDER: http | console
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --------------------------- FRONTEND -------------------------------
# Vazio = API no mesmo domínio (/api), como na Netlify. Nunca coloque segredos aqui.
VITE_API_URL=
