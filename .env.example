# =====================================================================
# GymFlow — variáveis de ambiente
# Copie para apps/api/.env (backend) e apps/web/.env (frontend).
# NUNCA faça commit de ficheiros .env com valores reais.
# =====================================================================

# ----------------------------- API ----------------------------------
NODE_ENV=development
PORT=4000
# SQLite em desenvolvimento. Em produção use PostgreSQL
# (altere provider em apps/api/prisma/schema.prisma para "postgresql").
DATABASE_URL="file:./dev.db"
# Origem(ns) autorizada(s) do frontend, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
# URL pública do frontend (usada em links de pagamento e recuperação de conta)
PUBLIC_APP_URL=http://localhost:5173
# Duração da sessão em horas
SESSION_TTL_HOURS=72
# Segredo para o endpoint de cron externo (POST /api/cron/reminders)
CRON_SECRET=change-me-to-a-long-random-string
# Executar o motor de lembretes dentro do processo (true/false)
REMINDERS_CRON_ENABLED=true

# ---- WhatsApp (Meta Cloud API ou provedor compatível) ----
# WHATSAPP_PROVIDER: meta | console
WHATSAPP_PROVIDER=console
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Email ----
# EMAIL_PROVIDER: smtp | console
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GymFlow <no-reply@example.com>"

# ---- SMS (provedor HTTP genérico) ----
# SMS_PROVIDER: http | console
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --------------------------- FRONTEND -------------------------------
# Apenas variáveis públicas (prefixo VITE_). Nunca coloque segredos aqui.
VITE_API_URL=http://localhost:4000
